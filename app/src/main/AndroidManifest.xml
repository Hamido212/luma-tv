<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Normal install-time permission: read whether Wi-Fi, Ethernet or nothing is connected
         for the status icon. No internet permission, no location, no Wi-Fi scanning. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <package android:name="com.android.tv" />
        <package android:name="com.droidlogic.android.tv" />
        <package android:name="com.google.android.tv.inputplayer" />
    </queries>
    <application android:label="${appLabel}" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_luma" android:banner="@drawable/tv_banner"
        android:theme="@style/LumaTheme"
        android:supportsRtl="true">
        <!-- Home since 0.3: quiet photo Home after CleanFrame (Dock or List). -->
        <activity android:name=".stage.StageActivity" android:exported="true"
            android:theme="@style/LumaStage"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Classic category dashboard, opened from Settings → TV & Luma. -->
        <activity android:name=".ui.DashboardActivity" android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing" />
    </application>
</manifest>
